{
  "name": "@elearner/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background jobs: reminders, Meet recording + attendance sync, ffmpeg HLS transcoding, Calendar sync, maintenance.",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.901.0",
    "@aws-sdk/lib-storage": "3.901.0",
    "@aws-sdk/s3-request-presigner": "3.901.0",
    "@elearner/core": "workspace:*",
    "@elearner/db": "workspace:*",
    "@elearner/google": "workspace:*",
    "@elearner/notify": "workspace:*",
    "@elearner/queue": "workspace:*",
    "@elearner/storage": "workspace:*",
    "@googleapis/calendar": "16.0.0",
    "@googleapis/drive": "22.0.0",
    "@googleapis/meet": "5.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "5.61.0",
    "google-auth-library": "10.5.0",
    "ioredis": "5.8.1",
    "nodemailer": "10.0.12",
    "pg": "8.16.3",
    "pino": "9.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
