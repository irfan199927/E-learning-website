# ─────────────────────────────────────────────────────────────
# E-learner environment. Copy to `.env` for local development.
# Every variable is documented in docs/environment.md.
# Apps validate this at boot and refuse to start if anything is missing.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug
APP_URL=http://localhost:3000

# ── Data stores (docker compose provides these locally) ──
DATABASE_URL=postgresql://elearner:elearner@localhost:5432/elearner
REDIS_URL=redis://localhost:6379

# ── Auth (Better Auth) ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-plus-random-bytes-base64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only accounts from this Workspace domain may use Google sign-in / Google APIs.
GOOGLE_WORKSPACE_DOMAIN=school.edu

# ── Encryption of stored Google refresh tokens (AES-256-GCM) ──
# Comma-separated keyring "<keyId>:<base64 32-byte key>". Generate a key with: openssl rand -base64 32
TOKEN_ENC_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY=
TOKEN_ENC_ACTIVE_KEY_ID=v1

# ── Object storage (Cloudflare R2 in prod, MinIO locally) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=elearner-media
S3_ACCESS_KEY_ID=elearner
S3_SECRET_ACCESS_KEY=elearner-secret
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit locally: UI at http://localhost:8025) ──
SMTP_URL=smtp://localhost:1025
MAIL_FROM="E-learner <no-reply@school.edu>"

# ── Limits & behaviour ──
MAX_UPLOAD_BYTES=4294967296
JOIN_OPENS_MINUTES_BEFORE=10
ATTENDANCE_PRESENT_RATIO=0.5
AUTH_SIGNIN_LIMIT_PER_MIN=5

# ── Worker ──
WORKER_HEALTH_PORT=8080
TRANSCODE_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Observability (optional) ──
SENTRY_DSN=
