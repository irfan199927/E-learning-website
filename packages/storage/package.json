{
  "name": "@elearner/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S3-compatible object storage (Cloudflare R2 in prod, MinIO locally): multipart uploads, presigned URLs, streaming puts.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.901.0",
    "@aws-sdk/lib-storage": "3.901.0",
    "@aws-sdk/s3-request-presigner": "3.901.0"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  }
}
